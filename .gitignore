# ---------------------------------------------------------------------------
# Private network data
# Script outputs can contain real network details (device names, subnets,
# firewall rules, serials). None of it belongs in this public repository.
# ---------------------------------------------------------------------------
logs/
*.log
backup_json/
backups/
csv_exports/
exports/
output/
reports/
*.csv
*.xlsx
*.pdf

# Secrets: the Meraki API key is read from the MERAKI_API_KEY environment
# variable and must never be committed.
.env
.env.*
!.env.example

